# ── Premium Motion UI Refresh ────────────────────────────────────────────
# Feature flag for the experimental elegant-motion layer (branch
# feature/premium-motion-ui-refresh): page atmospheres, subtle motion system
# and the Floating Command Bar.
#
#   true  → new premium-motion layer is active
#   false → original stable THRONE design (full revert, no code changes needed)
VITE_ENABLE_PREMIUM_MOTION_REFRESH=true

# ── THRONE UI/UX Polish Test (branch feature/throne-ui-ux-polish-test) ────
# Controlled refinement layer on top of the premium design: more editorial/
# compact inner pages, tightened typography, calmer cards, per-page polish.
#   true  → polish test active   ·   false → current stable design
VITE_ENABLE_THRONE_POLISH_TEST=true
