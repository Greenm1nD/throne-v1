# See docs/architecture.md section 14 for full details.
# Required variables are listed with empty values. Optional variables are
# commented out with their default shown; uncomment to override.

NODE_ENV=
# PORT=3000
# LOG_LEVEL=info

APP_URL=
API_URL=
CORS_ORIGINS=
# Defaults to false (do not trust X-Forwarded-For): with no proxy confirmed
# in front of the API, trusting it would let a client set its own request.ip
# via that header and bypass a future per-IP rate limit from day one. Set to
# true, a hop count (e.g. 1), or a comma-separated IP/CIDR allowlist once a
# reverse proxy that overwrites (not appends) this header is in place.
# TRUST_PROXY=false

DATABASE_URL=
# DATABASE_URL_TEST=
# REDIS_URL=

OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_SUMMARY_MODEL=OPENAI_MODEL
# Required when KNOWLEDGE_PROVIDER=openai_vector_store (the default).
OPENAI_VECTOR_STORE_ID=

# KNOWLEDGE_PROVIDER=openai_vector_store
# KNOWLEDGE_MIN_SCORE=0.3

N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
# N8N_SUPPORT_TICKET_PATH=throne/support-ticket

# Must be at least 32 characters.
VISITOR_TOKEN_SECRET=
# VISITOR_TOKEN_TTL_DAYS=90

# USER_AUTH_PROVIDER=none
# Required when USER_AUTH_PROVIDER=jwks.
# USER_AUTH_JWKS_URL=
# USER_AUTH_ISSUER=
# USER_AUTH_AUDIENCE=

# RATE_LIMIT_MESSAGES_PER_MIN=20
# RATE_LIMIT_REQUESTS_PER_MIN=60

# AI_MAX_TOOL_ROUNDS=5
# AI_REQUEST_TIMEOUT_MS=60000
# AI_TURN_BUDGET_MS=90000
# AI_MAX_OUTPUT_TOKENS=1024
# CONTEXT_RECENT_MESSAGES=20
# CONVERSATION_RETENTION_DAYS=180
