# Copy to .env to override. Defaults below reflect the STABLE design.

# Premium Motion UI Refresh — set true to enable the experimental motion layer.
VITE_ENABLE_PREMIUM_MOTION_REFRESH=false

# Plausible analytics. Unset → no script loads and no events are sent.
# VITE_PLAUSIBLE_DOMAIN=throne.example
# Only when self-hosting Plausible:
# VITE_PLAUSIBLE_HOST=https://analytics.throne.example
